# ============================================================
# EmailJS Configuration — Copy to .env and fill in your values
# ============================================================
# Sign up at https://www.emailjs.com (free tier: 200 emails/month)
# Dashboard → Account → API Keys → Public Key
VITE_EMAILJS_PUBLIC_KEY=your_emailjs_public_key_here

# Dashboard → Email Services → Add New Service → copy Service ID
VITE_EMAILJS_SERVICE_ID=your_emailjs_service_id_here

# Dashboard → Email Templates → Create Template → copy Template ID
VITE_EMAILJS_TEMPLATE_ID=your_emailjs_template_id_here

# Your actual email address (where messages will be received)
VITE_CONTACT_EMAIL=your_email@example.com
